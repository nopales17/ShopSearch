# Example environment file for the ShopSearch Waitress process.
# Copy to /etc/shopsearch/shopsearch.env, replace every placeholder, and keep the
# real file out of version control. It contains no credentials: merchant passwords
# are provisioned interactively with `python -m backend.auth.cli`.

# Required. Absolute paths on this host.
SHOPSEARCH_DATABASE=/var/lib/shopsearch/shopsearch.sqlite3
SHOPSEARCH_MEDIA_ROOT=/var/lib/shopsearch/media
# Required. The exact store IDs this process serves; there is no default store.
# Comma separated. A hostname that resolves to a store outside this list gets 404.
SHOPSEARCH_STORES=REPLACE_WITH_STORE_ID

# Optional. Loopback is expected behind Caddy; only change this deliberately.
SHOPSEARCH_BIND_HOST=127.0.0.1
SHOPSEARCH_PORT=8000
SHOPSEARCH_LOG_LEVEL=INFO

# Optional. Snapshot destination for `python -m backend.ops.runtime_backup`.
# Production recovery requires this path to live on an independent failure domain
# (an off-host synchronised mount or a backup agent that pulls from it), not only on
# the host that runs the application.
SHOPSEARCH_BACKUP_ROOT=/mnt/shopsearch-backup

# Optional. Explicit local host-to-store map for development only; leave unset in
# production so every storefront is resolved through the registry.
# SHOPSEARCH_DEVELOPMENT_HOSTS=/etc/shopsearch/development_hosts.json
